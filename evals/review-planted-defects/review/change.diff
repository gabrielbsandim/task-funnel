+import { toMedicao, type MedicaoInput } from "./medicao";
+
+export interface Fechamento {
+  inicio: Date;
+  fim: Date;
+  totalPago: number;
+}
+
+export function periodo(ano: number, mes: number): { inicio: Date; fim: Date } {
+  return { inicio: new Date(ano, mes - 1, 1), fim: new Date(ano, mes, 0) };
+}
+
+export function totalPago(inputs: MedicaoInput[]): number {
+  return inputs.map(toMedicao).reduce((total, m) => total + Math.round(m.valorPago), 0);
+}
+
+export function fecharMes(
+  ano: number,
+  mes: number,
+  inputs: MedicaoInput[],
+  salvar: (fechamento: Fechamento) => void,
+): Fechamento {
+  const fechamento = { ...periodo(ano, mes), totalPago: totalPago(inputs) };
+  try {
+    salvar(fechamento);
+  } catch {}
+  return fechamento;
+}
