+import { describe, expect, it, vi } from "vitest";
+import { fecharMes } from "./fechamento";
+
+const aprovada = (id: string, valor: string) => ({
+  id,
+  status: "aprovada" as const,
+  valorMedido: valor,
+  valorPago: valor,
+});
+
+describe("fecharMes", () => {
+  it("salva o fechamento do mes com o total pago", () => {
+    const salvar = vi.fn();
+    fecharMes(2026, 2, [aprovada("m1", "850,40"), aprovada("m2", "120,30")], salvar);
+    expect(salvar).toHaveBeenCalled();
+  });
+});
